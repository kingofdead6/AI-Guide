# Copy this file to .env and fill it in.

# MongoDB connection string, e.g. from MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ai-guide-academy?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

PORT=4000

# The admin account is created (or promoted) from these on server start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin

# Only needed if the client is hosted on a different domain than the API (comma separated).
CLIENT_ORIGIN=
